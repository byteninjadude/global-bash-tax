      "Bookkeeping",
      "Payroll processing",
      "Sales-tax registration or filing",
      "Legal entity formation",
      "Legal advice",
      "Investment advice",
      "IRS audit representation",
      "Ongoing accounting services",
    ],
  },
];

const faqs = [
  {
    question:
      "Which business tax returns do you prepare?",
    answer:
      "Global Bash prepares qualifying Forms 1120, 1120S, 1065, Schedule C filings, and applicable state returns.",
  },
  {
    question:
      "Can you help me decide whether to elect S-corporation status?",
    answer:
      "Milana can discuss general tax considerations connected with different filing structures. Legal formation and liability questions should be reviewed with an appropriate attorney.",
  },
  {
    question: "Do you provide bookkeeping?",
    answer:
      "Bookkeeping is not currently advertised as a confirmed standalone service.",
  },
  {
    question: "Do you process payroll?",
    answer:
      "Payroll processing and broader payroll-service scope are not currently advertised.",
  },
  {
    question:
      "How much does a business return cost?",
    answer:
      "Pricing depends on the entity, condition of the records, ownership structure, required schedules, assets, number of states involved, and overall complexity.",
  },
];

const relatedLinks = [
  {
    label: "Tax Planning",
    href: "/tax-services/tax-planning/",
  },
  {
    label: "Self-Employed Tax Services",
    href:
      "/tax-services/self-employed-tax-services/",
  },
  {
    label: "Multi-State Tax Preparation",
    href:
      "/tax-services/multi-state-tax-preparation/",
  },
  {
    label: "Real Estate Investor Tax Services",
    href:
      "/tax-services/real-estate-investor-tax-services/",
  },
];
---

<ServicePageLayout
  title="Business Tax Preparation Services | Global Bash"
  description="Remote business tax preparation for qualifying corporations, S corporations, partnerships, LLCs, and self-employed business owners with Global Bash."
  canonicalPath="/tax-services/business-tax-preparation/"
  eyebrow="Business Tax Preparation"
  heading="Business Tax Preparation With Personal Guidance"
  introduction={[
    "Business tax returns require accurate income and expense reporting, organized records, entity-specific forms, and attention to filing deadlines.",
    "Global Bash provides remote tax preparation for qualifying businesses and owners who want direct communication and professional review.",
  ]}
  primaryCtaLabel="Request a Business Tax Consultation"
  primaryCtaHref="/book-tax-consultation/?service=business-tax-preparation"
  sections={sections}
  faqs={faqs}
  relatedLinks={relatedLinks}
  finalCtaHeading="Discuss Your Business Tax Needs"
  finalCtaText="Request a consultation to discuss your entity, tax year, return type, business records, states involved, and filing requirements."
/>