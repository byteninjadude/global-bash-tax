const faqs = [
  {
    question: "What if I did not receive a Form 1099?",
    answer:
      "Business income may still need to be reported even if no Form 1099 was received. The reporting requirement depends on the income actually earned and the applicable tax rules.",
  },
  {
    question: "Can I deduct all of my business expenses?",
    answer:
      "No. Expenses must meet applicable tax requirements and should be supported by appropriate records. Personal expenses are generally not deductible as business expenses.",
  },
