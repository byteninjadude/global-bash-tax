      "State withholding",
      "Business locations and activity",
      "Rental-property locations",
      "Partnership or shareholder statements",
      "Prior-year state returns",
      "Estimated state tax payments",
    ],
  },
  {
    eyebrow: "Remote Process",
    title: "How Multi-State Preparation Works",
    steps: [
      {
        title: "Identify Every State",
        text:
          "List each state connected with residence, work, business, property, or income.",
      },
      {
        title: "Review Residency and Income",
        text:
          "Milana reviews timing, income source, and state documents involved.",
      },
      {
        title: "Confirm Filing Scope",
        text:
          "The likely federal and state returns are identified before pricing is confirmed.",
      },
      {
        title: "Provide Documents Securely",
        text:
          "State and federal records are provided through the approved secure process.",
      },
      {
        title: "Prepare the Returns",
        text:
          "Applicable resident, part-year, or nonresident returns are prepared.",
      },
    ],
  },
];

const faqs = [
  {
    question: "Do I need to file in every state where I worked?",
    answer:
      "Not always. Filing requirements depend on residency, work location, income source, withholding, reciprocity agreements, and state-specific rules.",
  },
  {
    question: "What if I moved from Illinois to Florida?",
    answer:
      "The dates of the move, residency facts, income sources, and state withholding must be reviewed to determine the appropriate filing treatment.",
  },
  {
    question: "Does rental property in another state require a return?",
    answer:
      "It may. Rental income connected with property in another state can create a nonresident filing requirement.",
  },
  {
    question: "Can you prepare returns for states other than Illinois and Florida?",
    answer:
      "Multi-state returns may be accepted depending on the states involved, type of income, and complexity of the filing requirements.",
  },
];

const relatedLinks = [
  {
    label: "Individual Tax Preparation",
    href: "/tax-services/individual-tax-preparation/",
  },
  {
    label: "Business Tax Preparation",
    href: "/tax-services/business-tax-preparation/",
  },
  {
    label: "Real Estate Investor Tax Services",
    href: "/tax-services/real-estate-investor-tax-services/",
  },
  {
    label: "Remote Tax Preparation",
    href: "/tax-services/remote-tax-preparation/",
