---
interface Props {
  title: string;
  description?: string;
  href?: string;
}

const {
  title,
  description,
  href,
} = Astro.props;
---

<article class="audience-card">
  <h3>{title}</h3>

  {
    description && (
      <p>{description}</p>
    )
  }

  {
    href && (
      <a
        class="text-link"
        href={href}
      >
        Learn more
      </a>
    )
  }
</article>