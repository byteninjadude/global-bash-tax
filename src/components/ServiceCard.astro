---
interface Props {
  title: string;
  description: string;
  href: string;
  linkLabel?: string;
}

const {
  title,
  description,
  href,
  linkLabel = "Learn more",
} = Astro.props;
---

<article class="service-card">
  <h3>{title}</h3>

  <p>{description}</p>

  <a
    class="service-card__link"
    href={href}
  >
    {linkLabel}
    <span aria-hidden="true">→</span>
  </a>
</article>