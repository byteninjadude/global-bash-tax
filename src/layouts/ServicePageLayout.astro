---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ConsultationCta from "../components/ConsultationCta.astro";
import { site } from "../config/site";

interface ContentCard {
  title: string;
  text: string;
}

interface ProcessStep {
  title: string;
  text: string;
}

interface PageSection {
  eyebrow?: string;
  title: string;
  paragraphs?: string[];
  bullets?: string[];
  cards?: ContentCard[];
  steps?: ProcessStep[];
  note?: string;
  relatedLink?: {
    label: string;
    href: string;
  };
}

interface FaqItem {
  question: string;
  answer: string;
}

interface RelatedLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;

  eyebrow: string;
  heading: string;
  introduction: string[];

  primaryCtaLabel: string;
  primaryCtaHref?: string;

  sections: PageSection[];
  faqs?: FaqItem[];
  relatedLinks?: RelatedLink[];

  finalCtaHeading: string;
  finalCtaText: string;
}

const {
  title,
  description,
  canonicalPath,
  eyebrow,
  heading,
  introduction,
  primaryCtaLabel,
  primaryCtaHref = "/book-tax-consultation/",
  sections,
  faqs = [],
  relatedLinks = [],
  finalCtaHeading,
  finalCtaText,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          {
            label: "Tax Services",
            href: "/tax-services/",
          },
          { label: heading },
        ]}
      />

      <div class="page-hero__content">
        <p class="eyebrow">{eyebrow}</p>

        <h1>{heading}</h1>

        {
          introduction.map((paragraph) => (
            <p>{paragraph}</p>
          ))
        }

        <div class="button-group">
          <a
            class="button button--primary"
            href={primaryCtaHref}
          >
            {primaryCtaLabel}
          </a>

          <a
            class="button button--secondary"
            href={site.phoneHref}
          >
            Call {site.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>

  {
    sections.map((section, index) => (
      <section
        class:list={[
          "section",
          index % 2 === 1 && "section--light",
        ]}
      >
        <div class="container content-page">
          {section.eyebrow && (
            <p class="eyebrow">{section.eyebrow}</p>
          )}

          <h2>{section.title}</h2>

          {section.paragraphs?.map((paragraph) => (
            <p>{paragraph}</p>
          ))}

          {section.bullets && (
            <ul class="check-list">
              {section.bullets.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}

          {section.cards && (
            <div class="content-card-grid">
              {section.cards.map((card) => (
                <article class="content-card">
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </article>
              ))}
            </div>
          )}

          {section.steps && (
            <ol class="process-grid">
              {section.steps.map((step, stepIndex) => (
                <li>
                  <span class="process-grid__number">
                    {String(stepIndex + 1).padStart(2, "0")}
                  </span>

                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </li>
              ))}
            </ol>
          )}

          {section.note && (
            <aside class="information-note">
              <p>{section.note}</p>
            </aside>
          )}

          {section.relatedLink && (
            <p class="section-related-link">
              <a
                class="text-link"
                href={section.relatedLink.href}
              >
                {section.relatedLink.label}
              </a>
            </p>
          )}
        </div>
      </section>
    ))
  }

  {
    relatedLinks.length > 0 && (
      <section class="section related-services">
        <div class="container content-page">
          <p class="eyebrow">Related Services</p>

          <h2>Explore Related Tax Services</h2>

          <ul>
            {relatedLinks.map((link) => (
              <li>
                <a href={link.href}>
                  {link.label}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    faqs.length > 0 && (
      <section class="section section--light">
        <div class="container content-page">
          <p class="eyebrow">
            Frequently Asked Questions
          </p>

          <h2>Common Questions</h2>

          <div class="faq-list">
            {faqs.map((faq) => (
              <details class="faq-item">
                <summary>{faq.question}</summary>

                <div class="faq-item__answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ConsultationCta
    heading={finalCtaHeading}
    text={finalCtaText}
    buttonLabel={primaryCtaLabel}
    buttonHref={primaryCtaHref}
  />
</BaseLayout>